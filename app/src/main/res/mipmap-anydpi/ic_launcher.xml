<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon (L12, D83): the owner's logo (white artwork cut out of his image, drawable-nodpi/ic_launcher_foreground.png) on near-black; the same artwork is the
     monochrome layer for the themed icons of Android 13+. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
