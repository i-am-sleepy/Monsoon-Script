    <!-- Import logins from a CSV file (E1.23, D104) -->
    <string name="import_title">Import logins</string>
    <string name="import_row_summary">From Google Password Manager, Chrome or another manager (CSV file)</string>
    <string name="import_how_header">How it works</string>
    <string name="import_how">1. In the other password manager, export your passwords as a CSV file. For Google: open Google Password Manager (passwords.google.com, or Chrome > Settings > Passwords), tap the gear, then Export passwords. Do this once for each Google account.
2. Choose that file here and name a folder for it.
3. Repeat for the next account: logins that are already in your vault with the same password are skipped.</string>
    <string name="import_plain_warning">A CSV file is NOT encrypted: anyone who finds it can read every password in it. The vault reads it once, copies nothing, and offers to delete it afterwards.</string>
    <string name="import_choose">Choose a CSV file</string>
