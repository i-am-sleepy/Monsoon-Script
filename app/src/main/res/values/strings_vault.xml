    <string name="import_folder_header">Folder</string>
    <string name="import_folder_hint">Folder name</string>
    <string name="import_folder_note">The logins go into this folder (it is made when it does not exist). A login that is already in your vault with the same password is skipped. With a different password it is kept as a second entry, marked in its notes.</string>
