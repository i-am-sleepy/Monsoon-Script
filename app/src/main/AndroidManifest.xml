<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only VIBRATE (normal permission, no prompt; D55) for the vibration strength setting. INTERNET is allowed by DECISIONS D10 but is added only when a network feature exists. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice typing (G5, D66): runtime permission, asked on the first use of the mic key by the see-through VoicePermissionActivity. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The optional offline voice model download (G5, D66). Nothing else uses the network; Offline mode (D10) blocks even that. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Clipboard lock (E3.9, D71): normal permission (no prompt) for the phone's fingerprint / face prompt on Android 9+; only used when the lock is switched on. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Android 11+: without this the keyboard cannot see the phone's speech service and SpeechRecognizer.isRecognitionAvailable lies. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <service
            android:name=".ime.MonsoonIme"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- The vault as an Android Autofill service (E1.19, D100): offers logins in apps and browsers; the owner turns it on in Android's settings. -->
        <service
            android:name=".autofill.MonsoonAutofillService"
            android:exported="true"
            android:label="@string/autofill_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".settings.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsPageActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".theme.ThemesActivity"
            android:exported="false"
            android:label="@string/themes_title" />

        <activity
            android:name=".theme.PictureCropActivity"
            android:exported="false"
            android:label="@string/theme_crop_title" />

        <activity
            android:name=".theme.ThemeEditActivity"
            android:exported="false"
            android:label="@string/theme_edit_title"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".clipboard.app.ClipboardActivity"
            android:exported="false"
            android:label="@string/clip_title"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".clipboard.app.ClipboardSettingsActivity"
            android:exported="false"
            android:label="@string/clip_settings_title" />

        <activity
            android:name=".clipboard.ClipEditActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/clip_edit_title"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <activity
            android:name=".voice.VoiceSettingsActivity"
            android:exported="false"
            android:label="@string/voice_settings_title" />

        <activity
            android:name=".voice.ProblemsActivity"
            android:exported="false"
            android:label="@string/voice_problems_title" />

        <activity
            android:name=".voice.VoiceDiagActivity"
            android:exported="false"
            android:label="@string/voice_diag_title" />

        <activity
            android:name=".voice.VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The prompt of the clipboard lock (E3.9, D71): no screen of its own, shows the phone's fingerprint / face / screen lock prompt over the caller. -->
        <activity
            android:name=".clipboard.ClipUnlockActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Hands one saved clipboard picture at a time to the app it is pasted or shared into (E3.8, D70). Not exported: only an address given explicitly works. -->
        <provider
            android:name=".clipboard.ImageProvider"
            android:authorities="${applicationId}.clipimages"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".settings.LicensesActivity"
            android:exported="false"
            android:label="@string/settings_licenses" />
        <!-- Password vault screens (E1.13). Not exported; every one sets FLAG_SECURE itself (D43). The service they talk to lives in :vault (own process, D44). -->
        <activity
            android:name=".vault.VaultMainActivity"
            android:exported="false"
            android:label="@string/vault_title"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <!-- The see-through master-password card the keyboard's password picker opens over the app in front (E1.14, D37). -->
        <activity
            android:name=".vault.VaultUnlockActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|keyboard|navigation|density|fontScale|locale|layoutDirection"
            android:launchMode="singleInstance"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".vault.VaultCreateActivity"
            android:exported="false"
            android:label="@string/vault_create_title"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".vault.EntryActivity"
            android:exported="false"
            android:label="@string/vault_title" />
        <activity
            android:name=".vault.EntryEditActivity"
            android:exported="false"
            android:label="@string/vault_edit"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".vault.VaultSettingsActivity"
            android:exported="false"
            android:label="@string/vault_settings" />
        <activity
            android:name=".vault.VaultBackupsActivity"
            android:exported="false"
            android:label="@string/vault_backups_title" />

        <!-- Autofill's own screens (E1.19): the invisible one behind a tap in the dropdown, and "Search vault…". They sit in the task of the app being filled. -->
        <activity
            android:name=".autofill.AutofillFillActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|keyboard|navigation|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The small save screen after a login was typed in another app (E1.20): its own see-through task over that app, like the unlock card. -->
        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|keyboard|navigation|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".autofill.AutofillSearchActivity"
            android:exported="false"
            android:label="@string/autofill_search_title"
            android:windowSoftInputMode="adjustResize|stateVisible" />

    </application>
</manifest>
