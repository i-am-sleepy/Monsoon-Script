<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only VIBRATE (normal permission, no prompt; D55) for the vibration strength setting. INTERNET is allowed by DECISIONS D10 but is added only when a network feature exists. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <service
            android:name=".ime.MonsoonIme"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".settings.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsPageActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".clipboard.app.ClipboardActivity"
            android:exported="false"
            android:label="@string/clip_title"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".clipboard.app.ClipboardSettingsActivity"
            android:exported="false"
            android:label="@string/clip_settings_title" />

        <activity
            android:name=".clipboard.ClipEditActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/clip_edit_title"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <activity
            android:name=".settings.LicensesActivity"
            android:exported="false"
            android:label="@string/settings_licenses" />
    </application>
</manifest>
