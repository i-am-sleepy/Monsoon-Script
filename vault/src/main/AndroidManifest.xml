<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- D44: the vault engine lives in its own Android process. Phase 0 spike service; no one starts it yet. -->
        <service
            android:name=".VaultSpikeService"
            android:exported="false"
            android:process=":vault" />

        <!-- Phase 0 spike ONLY (side branch, never for main): lets the CI shell trigger a smoke test of the shrunk build.
             Only holders of the DUMP permission (the adb shell, the system) may send to it. -->
        <receiver
            android:name=".VaultSmokeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
